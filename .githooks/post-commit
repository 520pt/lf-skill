#!/bin/sh
set -eu

remote="$(git config --get remote.origin.url || true)"
if [ -z "$remote" ]; then
  echo "未配置 origin，跳过自动推送。" >&2
  exit 0
fi

GIT_TERMINAL_PROMPT=0 git \
  -c credential.interactive=never \
  -c http.version=HTTP/1.1 \
  -c http.lowSpeedLimit=1 \
  -c http.lowSpeedTime=15 \
  push origin HEAD
